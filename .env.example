# ddalggak (ddk) configuration
# Copy this file to .env and fill in the values.
# All variables use the DDK_ prefix.
# ANTHROPIC_API_KEY is also accepted as a fallback.

# ---------------------------------------------------------------------------
# LLM / AI
# ---------------------------------------------------------------------------

# Runtime provider: anthropic. openai/fake are reserved config values and fail preflight.
# DDK_LLM_PROVIDER=anthropic

# Anthropic API key (required when DDK_LLM_PROVIDER=anthropic)
# Fallback: ANTHROPIC_API_KEY
DDK_ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use for heavy reasoning steps
# DDK_LLM_MODEL=claude-sonnet-5-5

# Claude model to use for fast/light tasks (classification, routing)
# DDK_LIGHT_MODEL=claude-haiku-5-5

# Reserved for a future OpenAI runtime adapter; currently unsupported by ddk run.
# DDK_OPENAI_API_KEY=sk-...

# Maximum per-run cost in USD (default: 2.0)
# DDK_COST_CAP_USD=2.0

# ---------------------------------------------------------------------------
# Sandbox
# ---------------------------------------------------------------------------

# Implemented sandbox mode: tempdir. Other values fail preflight instead of being ignored.
# DDK_SANDBOX_MODE=tempdir

# ---------------------------------------------------------------------------
# Visual / Playwright
# ---------------------------------------------------------------------------

# Browser for screenshot diff: chromium | firefox | webkit (default: chromium)
# DDK_PLAYWRIGHT_BROWSER=chromium

# SSIM similarity threshold — below this triggers a visual regression failure
# (default: 0.92, range: 0.0–1.0)
# DDK_SSIM_THRESHOLD=0.92

# ---------------------------------------------------------------------------
# Pipeline behaviour
# ---------------------------------------------------------------------------

# Maximum autofix retry attempts (default: 3, range: 1–10)
# DDK_MAX_RETRY_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Log level: INFO | DEBUG (default: INFO)
# DDK_LOG_LEVEL=INFO
